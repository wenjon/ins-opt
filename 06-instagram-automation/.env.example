# Instagram Graph API 配置
# 复制此文件为 .env 并填入你的真实凭证

# Instagram Business Account ID
# 获取方式：Graph API Explorer 输入 /me/accounts 查询
# 或 Meta Business Suite → Settings → Accounts
IG_BUSINESS_ID=your_instagram_business_account_id

# Long-Lived Access Token
# 获取方式：先获取 short-lived token，再用 https://graph.instagram.com/access_token 换 long-lived
# 有效期 60 天，需要定期刷新
IG_ACCESS_TOKEN=your_long_lived_access_token

# API 版本
# 推荐 v18.0 或更新
GRAPH_API_VERSION=v18.0

# 数据输出目录（相对脚本所在目录）
DATA_DIR=data

# 调试模式（true/false，输出更详细的日志）
DEBUG=false
